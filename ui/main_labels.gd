static func message(key: String, language: String) -> String:
	var messages: Dictionary = DATA.get(language, DATA["en"])
	return str(messages.get(key, "!" + key + "!"))


static func mnemonic(caption_key: String, language: String) -> int:
	assert(not caption_key.is_empty(), "A caption key is required")
	var messages: Dictionary = DATA.get(language, DATA["en"])
	var value: String = str(messages.get(caption_key + "_MNEMONIC", caption_key))
	return OS.find_keycode_from_string(value.left(1))



static func format_number(value: float, language: String, precision: int = 2) -> String:
	assert(precision == 1 or precision == 2, "Main display precision must be one or two digits")
	var symbols: Dictionary = NUMBER_FORMATS.get(language, NUMBER_FORMATS["en"])
	if is_nan(value):
		return str(symbols["nan"])
	if is_inf(value):
		return str(symbols["negative_infinity"] if value < 0.0 else symbols["positive_infinity"])
	var fixed: String = ("%.1f" if precision == 1 else "%.2f") % value
	var negative: bool = fixed.begins_with("-")
	var parts: PackedStringArray = fixed.trim_prefix("-").split(".")
	var integer: String = parts[0]
	var grouped: String = ""
	for index: int in range(integer.length()):
		if index > 0 and (integer.length() - index) % 3 == 0:
			grouped += str(symbols["group"])
		grouped += integer.substr(index, 1)
	return ("-" if negative else "") + grouped + str(symbols["decimal"]) + parts[1]
