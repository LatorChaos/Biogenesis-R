[configuration]
entry_symbol = "bgr_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libbiogenesis_godot.so"
linux.release.x86_64 = "res://bin/libbiogenesis_godot.so"
linux.debug.arm64 = "res://bin/libbiogenesis_godot.arm64.so"
linux.release.arm64 = "res://bin/libbiogenesis_godot.arm64.so"
